{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // `fetchNet` is the browser half of this package, so it needs `fetch` and `Response` declared.
    // Node has both as globals too, and nothing here touches the document.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*"]
}

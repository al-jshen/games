node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# The server's runtime replay directory, at the repo root only. Deliberately anchored with a
# leading slash: a bare `data/` also swallows packages/games/splendor-duel/data/cards.json, which
# is a generated-but-reviewable source artefact that belongs in the repo.
/data/

# scratch caches for one-off data/asset derivation tools
.cache/
tools/*/.cache/

# python. Glob rather than a bare `.venv/`, because a venv is tied to the machine that built it and
# a checkout shared between two -- a laptop and a big Linux box, say -- needs one of each.
__pycache__/
*.egg-info/
.venv*/
venv/

.DS_Store

# playwright
test-results/
playwright-report/
blob-report/

# Generated self-play datasets. Large, reproducible from a seed, and not source.
.data/

# Session transcripts pasted in for context. Scratch, not source -- and `git add -A` will
# happily commit 90KB of them if nothing says otherwise. It already did once.
splendorcontext.txt
*context.txt
